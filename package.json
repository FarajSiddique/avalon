{
  "name": "avalon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "wrangler types > /dev/null && oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:restart": "node scripts/restart-check.mjs",
    "test:api": "cd bruno && pnpm dlx @usebruno/cli@4 run --env local",
    "stores": "node scripts/stores.mjs",
    "screenshots": "playwright test --project=screenshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:restart",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5"
}
